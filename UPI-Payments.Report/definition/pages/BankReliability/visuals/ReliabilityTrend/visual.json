{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "ReliabilityTrend",
  "position": {
    "x": 640,
    "y": 180,
    "width": 400,
    "height": 340,
    "z": 6
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "MonthLabel"
                }
              },
              "queryRef": "Dim_Date.MonthLabel",
              "nativeQueryRef": "MonthLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Remitter"
                    }
                  },
                  "Property": "Technical Decline Rate %"
                }
              },
              "queryRef": "Fact_Remitter.Technical Decline Rate %",
              "nativeQueryRef": "Technical Decline Rate %"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Dim_Date"
                  }
                },
                "Property": "MonthLabel"
              }
            },
            "direction": "Ascending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Weighted technical decline by month'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
