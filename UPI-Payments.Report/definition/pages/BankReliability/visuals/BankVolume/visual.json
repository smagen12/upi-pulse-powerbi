{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "BankVolume",
  "position": {
    "x": 20,
    "y": 180,
    "width": 600,
    "height": 340,
    "z": 5
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Bank"
                    }
                  },
                  "Property": "Bank"
                }
              },
              "queryRef": "Dim_Bank.Bank",
              "nativeQueryRef": "Bank"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Remitter"
                    }
                  },
                  "Property": "Bank Attempts"
                }
              },
              "queryRef": "Fact_Remitter.Bank Attempts",
              "nativeQueryRef": "Bank Attempts"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Fact_Remitter"
                  }
                },
                "Property": "Bank Attempts"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Bank attempts | covered top 50 each month'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
